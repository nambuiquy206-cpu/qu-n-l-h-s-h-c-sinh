@model ThptA.ViewModels.TeacherAccountVm

@{
    ViewData["Title"] = "Thêm tài khoản giáo viên";
}

<div class="container mt-4">
    <h2>Thêm tài khoản giáo viên chủ nhiệm</h2>

    <div class="row">
        <div class="col-md-6">

            <form asp-controller="AdminAccounts"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="All"
                     class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="UserName">
                        Tên đăng nhập
                    </label>

                    <input asp-for="UserName"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="FullName">
                        Họ tên giáo viên
                    </label>

                    <input asp-for="FullName"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Password">
                        Mật khẩu
                    </label>

                    <input asp-for="Password"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword">
                        Xác nhận mật khẩu
                    </label>

                    <input asp-for="ConfirmPassword"
                           class="form-control" />
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Tạo tài khoản
                </button>

                <a asp-controller="AdminAccounts"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>
            </form>

        </div>
    </div>
</div>
