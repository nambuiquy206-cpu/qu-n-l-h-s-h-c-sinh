@model ThptA.Models.Student

@{
    ViewData["Title"] = "Chi tiết hồ sơ học sinh";
}

<div class="container mt-4">

    <h2 class="mb-4">Chi tiết hồ sơ học sinh</h2>

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- THEO DÕI KHOẢN THU -->
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex flex-wrap gap-2 mb-3">

            <a asp-controller="StudentFees"
               asp-action="Index"
               asp-route-studentId="@Model.Id"
               class="btn btn-outline-primary">
                Theo dõi khoản thu
            </a>

            

        </div>
    }


    <!-- THÔNG TIN HỌC SINH -->
    <div class="card mb-4">

        <div class="card-header bg-primary text-white">
            Thông tin học sinh
        </div>

        <div class="card-body">

            <p>
                <strong>Mã học sinh:</strong>
                @Model.Code
            </p>

            <p>
                <strong>Họ tên:</strong>
                @Model.FullName
            </p>

            <p>
                <strong>Ngày sinh:</strong>
                @Model.BirthDate.ToString("dd/MM/yyyy")
            </p>

            <p>
                <strong>Giới tính:</strong>
                @(Model.Gender == "M" ? "Nam" :
                  Model.Gender == "F" ? "Nữ" : "Khác")
            </p>

            <p>
                <strong>Địa chỉ:</strong>
                @Model.Address
            </p>

            <p>
                <strong>Lớp học:</strong>
                @Model.SchoolClass?.Name
            </p>

            <p>
                <strong>Năm học:</strong>
                @Model.SchoolClass?.AcademicYear?.Code
            </p>

            <p>
                <strong>Trạng thái:</strong>

                @if (Model.Status == "Active")
                {
                    <span class="badge bg-success">
                        Đang học
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Ngừng học
                    </span>
                }
            </p>

        </div>
    </div>

    <!-- NGƯỜI LIÊN HỆ CHÍNH -->
    <div class="card mb-4">

        <div class="card-header bg-secondary text-white">
            Người liên hệ chính
        </div>

        <div class="card-body">

            @if (Model.PrimaryContact != null)
            {
                <p>
                    <strong>Họ tên:</strong>
                    @Model.PrimaryContact.FullName
                </p>

                <p>
                    <strong>Quan hệ:</strong>
                    @Model.PrimaryContact.Relationship
                </p>

                <p>
                    <strong>Số điện thoại:</strong>
                    @Model.PrimaryContact.Phone
                </p>
            }
            else
            {
                <p>Chưa có thông tin người liên hệ.</p>
            }

        </div>
    </div>

    <!-- KHU VỰC NÚT THAO TÁC -->
    <div class="d-flex flex-wrap align-items-center gap-2 mt-4 mb-4">

        <!-- Quay lại danh sách -->
        <a asp-controller="Students"
           asp-action="Index"
           class="btn btn-secondary">
            Quay lại danh sách
        </a>

        <!-- Đổi trạng thái: chỉ Admin -->
        @if (User.IsInRole("Admin"))
        {
            <form asp-controller="Students"
                  asp-action="ChangeStatus"
                  method="post"
                  class="m-0">

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                @if (Model.Status == "Active")
                {
                    <input type="hidden"
                           name="status"
                           value="Inactive" />

                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Chuyển học sinh sang trạng thái Ngừng học?')">
                        Chuyển sang Ngừng học
                    </button>
                }
                else
                {
                    <input type="hidden"
                           name="status"
                           value="Active" />

                    <button type="submit"
                            class="btn btn-success"
                            onclick="return confirm('Chuyển học sinh sang trạng thái Đang học?')">
                        Chuyển sang Đang học
                    </button>
                }

            </form>
        }

        <!-- Xem thời khóa biểu -->
        @if (Model.SchoolClass != null)
        {
            <a asp-controller="Timetables"
               asp-action="Index"
               asp-route-schoolClassId="@Model.ClassId"
               class="btn btn-info">
                Xem thời khóa biểu lớp
            </a>
        }

        <!-- Chuyển lớp: chỉ Admin -->
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Students"
               asp-action="TransferClass"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Chuyển lớp
            </a>
        }

        <!-- Chỉnh sửa hồ sơ -->
        <a asp-controller="Students"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Chỉnh sửa hồ sơ
        </a>

    </div>

</div>
