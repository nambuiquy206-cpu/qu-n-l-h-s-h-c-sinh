@model ThptA.Models.Student

@{
    ViewData["Title"] = "Chi tiết hồ sơ học sinh";
}

<div class="container mt-4">

    <h2>Chi tiết hồ sơ học sinh</h2>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            Thông tin học sinh
        </div>

        <div class="card-body">
            <p>
                <strong>Mã học sinh:</strong>
                @Model.Code
            </p>

            <p>
                <strong>Họ tên:</strong>
                @Model.FullName
            </p>

            <p>
                <strong>Ngày sinh:</strong>
                @Model.BirthDate.ToString("dd/MM/yyyy")
            </p>

            <p>
                <strong>Giới tính:</strong>
                @(Model.Gender == "M" ? "Nam" :
                  Model.Gender == "F" ? "Nữ" : "Khác")
            </p>

            <p>
                <strong>Địa chỉ:</strong>
                @Model.Address
            </p>

            <p>
                <strong>Lớp học:</strong>
                @Model.SchoolClass?.Name
            </p>

            <p>
                <strong>Năm học:</strong>
                @Model.SchoolClass?.AcademicYear?.Code
            </p>

            <p>
                <strong>Trạng thái:</strong>
                @(Model.Status == "Active"
                    ? "Đang học" : "Ngừng học")
            </p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            Người liên hệ chính
        </div>

        <div class="card-body">
            @if (Model.PrimaryContact != null)
            {
                <p>
                    <strong>Họ tên:</strong>
                    @Model.PrimaryContact.FullName
                </p>

                <p>
                    <strong>Quan hệ:</strong>
                    @Model.PrimaryContact.Relationship
                </p>

                <p>
                    <strong>Số điện thoại:</strong>
                    @Model.PrimaryContact.Phone
                </p>
            }
            else
            {
                <p>Chưa có thông tin người liên hệ.</p>
            }
        </div>
    </div>

    <a asp-controller="Students"
       asp-action="Index"
       class="btn btn-secondary">
        Quay lại danh sách

        <a asp-controller="Students"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning me-2">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @if (User.IsInRole("Admin"))
            {
                <form asp-controller="Students"
                      asp-action="ChangeStatus"
                      method="post"
                      class="mb-3">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    @if (Model.Status == "Active")
                    {
                        <input type="hidden"
                               name="status"
                               value="Inactive" />

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Chuyển học sinh sang trạng thái Ngừng học?')">
                            Chuyển sang Ngừng học
                        </button>
                    }
                    else
                    {
                        <input type="hidden"
                               name="status"
                               value="Active" />

                        <button type="submit"
                                class="btn btn-success"
                                onclick="return confirm('Chuyển học sinh sang trạng thái Đang học?')">
                            Chuyển sang Đang học
                        </button>
                    }
                </form>
            }

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Students"
                   asp-action="TransferClass"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary me-2">
                    Chuyển lớp
                </a>
            }

           Chỉnh sửa hồ sơ
        </a>

    </a>

</div>
