@model ThptA.ViewModels.StudentListVm

@{
    ViewData["Title"] = "Quản lý hồ sơ học sinh";
}

<div class="container mt-4">

    <h2 class="mb-4">Quản lý hồ sơ học sinh</h2>

    <a asp-controller="Students"
       asp-action="Create"
       class="btn btn-primary mb-3">
        + Thêm học sinh
    </a>

    <!-- BỘ LỌC HỌC SINH -->
    <div class="card mb-4">

        <div class="card-header">
            Tìm kiếm và lọc hồ sơ
        </div>

        <div class="card-body">

            <form asp-controller="Students"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">
                            Mã hoặc họ tên học sinh
                        </label>

                        <input asp-for="Q"
                               class="form-control"
                               placeholder="Nhập mã hoặc họ tên..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Năm học
                        </label>

                        <select asp-for="YearId"
                                asp-items="Model.YearOptions"
                                class="form-select">
                            <option value="">
                                Tất cả năm học
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Khối
                        </label>

                        <select asp-for="Grade"
                                class="form-select">
                            <option value="">Tất cả khối</option>
                            <option value="10">Khối 10</option>
                            <option value="11">Khối 11</option>
                            <option value="12">Khối 12</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Lớp học
                        </label>

                        <select asp-for="ClassId"
                                asp-items="Model.ClassOptions"
                                class="form-select">
                            <option value="">
                                Tất cả lớp
                            </option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Trạng thái
                        </label>

                        <select asp-for="Status"
                                class="form-select">
                            <option value="">
                                Tất cả trạng thái
                            </option>
                            <option value="Active">
                                Đang học
                            </option>
                            <option value="Inactive">
                                Ngừng học
                            </option>
                        </select>
                    </div>

                </div>

                <div class="mt-3">
                    <button type="submit"
                            class="btn btn-primary">
                        Tìm kiếm
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Xóa bộ lọc
                    </a>
                </div>

            </form>
        </div>
    </div>

    <!-- KẾT QUẢ -->
    <h5>
        Kết quả tìm kiếm: @Model.Total học sinh
    </h5>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">

            <thead class="table-dark">
                <tr>
                    <th>Mã HS</th>
                    <th>Họ tên</th>
                    <th>Ngày sinh</th>
                    <th>Giới tính</th>
                    <th>Lớp</th>
                    <th>Năm học</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var student in Model.Students)
                {
                    <tr>
                        <td>@student.Code</td>
                        <td>@student.FullName</td>

                        <td>
                            @student.BirthDate.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @(student.Gender == "M" ? "Nam" :
                              student.Gender == "F" ? "Nữ" : "Khác")
                        </td>

                        <td>@student.SchoolClass?.Name</td>

                        <td>
                            @student.SchoolClass?.AcademicYear?.Code
                        </td>

                        <td>
                            @if (student.Status == "Active")
                            {
                                <span class="badge bg-success">
                                    Đang học
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Ngừng học
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-controller="Students"
                               asp-action="Details"
                               asp-route-id="@student.Id"
                               class="btn btn-info btn-sm">
                                Chi tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Students.Any())
    {
        <div class="alert alert-info">
            Không tìm thấy học sinh phù hợp.
        </div>
    }

    <!-- PHÂN TRANG -->
    @if (Model.PageCount > 1)
    {
        <nav aria-label="Phân trang học sinh">
            <ul class="pagination">

                @for (int p = Math.Max(1, Model.Page - 2);
                      p <= Math.Min(Model.PageCount, Model.Page + 2);
                      p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@p"
                           asp-route-q="@Model.Q"
                           asp-route-yearId="@Model.YearId"
                           asp-route-grade="@Model.Grade"
                           asp-route-classId="@Model.ClassId"
                           asp-route-status="@Model.Status">
                            @p
                        </a>

                    </li>
                }
            </ul>
        </nav>
    }

</div>
